# Canonical origin. Used for canonical tags, Open Graph URLs, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://albamedicaldiagnostics.com

# Google Search Console -> Settings -> Ownership verification -> HTML tag.
# Paste only the content value, e.g. "abc123...".
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Sanity (https://sanity.io/manage). Create a project, then copy its project ID here.
# Leave blank and the site still builds; the Articles page shows a short empty state.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
